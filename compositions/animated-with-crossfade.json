{
  "output": "animated-with-crossfade.mp4",
  "width": 1920,
  "height": 1080,
  "fps": 25,
  "scenes": [
    {
      "type": "image",
      "source": "flamengo.png",
      "duration": 4,
      "transform": {
        "scale": {
          "from": 1,
          "to": 1.2
        }
      }
    },
    {
      "type": "image",
      "source": "input.png",
      "duration": 4,
      "transform": {
        "pan": {
          "from": { "x": 0, "y": 0 },
          "to": { "x": 150, "y": 50 }
        }
      },
      "transition": {
        "type": "crossfade",
        "duration": 1
      }
    }
  ]
}
