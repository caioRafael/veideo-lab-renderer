{
  "name": "video-lab",
  "version": "1.0.0",
  "description": "Node.js/TypeScript library for composing and rendering videos with FFmpeg",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "scripts",
    "assets",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "tsx --test src/**/*.test.ts",
    "test:render": "tsx examples/smoke-render.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "video",
    "ffmpeg",
    "composition",
    "render"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "@types/node": "^26.4.1",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
