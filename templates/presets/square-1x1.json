{
  "name": "square-1x1",
  "version": 1,
  "variables": {
    "background": {
      "type": "asset",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "output": {
      "type": "string",
      "default": "square-1x1.mp4"
    }
  },
  "composition": {
    "output": "{{output}}",
    "width": 1080,
    "height": 1080,
    "fps": 25,
    "scenes": [
      {
        "type": "image",
        "source": "{{background}}",
        "duration": 6
      }
    ],
    "texts": [
      {
        "content": "{{title}}",
        "start": 0.4,
        "duration": 5.2,
        "x": "center",
        "y": "center",
        "fontSize": 56,
        "color": "#FFFFFF",
        "bold": true,
        "align": "center",
        "box": { "width": 860 }
      }
    ]
  }
}
