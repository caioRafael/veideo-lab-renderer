{
  "name": "youtube-short",
  "version": 1,
  "variables": {
    "background": {
      "type": "asset",
      "required": true
    },
    "overlay": {
      "type": "asset",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string",
      "required": true
    },
    "output": {
      "type": "string",
      "default": "youtube-short.mp4"
    }
  },
  "composition": {
    "output": "{{output}}",
    "width": 1080,
    "height": 1920,
    "fps": 25,
    "scenes": [
      {
        "type": "image",
        "source": "{{background}}",
        "duration": 8
      }
    ],
    "texts": [
      {
        "content": "{{title}}",
        "start": 0.4,
        "duration": 7.2,
        "x": "center",
        "y": 420,
        "fontSize": 72,
        "color": "#FFFFFF",
        "bold": true,
        "align": "center",
        "box": { "width": 900 }
      },
      {
        "content": "{{subtitle}}",
        "start": 1,
        "duration": 6.6,
        "x": "center",
        "y": 720,
        "fontSize": 36,
        "color": "#F2F2F2",
        "align": "center",
        "box": { "width": 860 }
      }
    ],
    "overlays": [
      {
        "source": "{{overlay}}",
        "start": 0.6,
        "duration": 6.8,
        "x": 400,
        "y": 1280,
        "width": 280,
        "height": 280
      }
    ]
  }
}
